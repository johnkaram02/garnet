<Project Sdk="Microsoft.NET.Sdk">

  <!-- See README.md. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Tsavorite.epoch.litmus</RootNamespace>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>../../Garnet.snk</AssemblyOriginatorKeyFile>
    <DelaySign>false</DelaySign>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>1701;1702;1591;IDE0130;IDE0065;IDE0007;IDE0048</NoWarn>

    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredCompilation>false</TieredCompilation>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DefineConstants>$(DefineConstants);GARNET_CLIENT_EPOCH</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\libs\storage\Tsavorite\cs\src\core\Tsavorite.core.csproj" />
  </ItemGroup>

  <UsingTask TaskName="GenerateReorderedEpoch" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SourceDirectory ParameterType="System.String" Required="true" />
      <OutputDirectory ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        Directory.CreateDirectory(OutputDirectory);
        foreach (var name in new[] { "LightEpoch.cs", "LightEpoch.EntryTable.cs" })
        {
            var text = File.ReadAllText(Path.Combine(SourceDirectory, name));
            const string clientNamespace = "namespace Garnet.client";
            if (!text.Contains(clientNamespace))
            {
                Log.LogError("{0}: '{1}' not found; the control cannot be generated", name, clientNamespace);
                return false;
            }
            text = text.Replace(clientNamespace, "namespace Tsavorite.epoch.litmus.ReorderedRelease");
            if (name == "LightEpoch.cs")
            {
                var regex = new Regex(@"(\s+)Release\(\);(\s+)if \(drainCount > 0\)(\s+)SuspendDrain\(\);");
                var matches = regex.Matches(text).Count;
                if (matches != 1)
                {
                    Log.LogError("{0}: expected one Suspend edit for the control, found {1}", name, matches);
                    return false;
                }
                text = regex.Replace(text, "$1var drainPending = drainCount > 0;$1Thread.SpinWait(64);$1Release();$2if (drainPending)$3SuspendDrain();");
            }
            File.WriteAllText(Path.Combine(OutputDirectory, name), "// <auto-generated/>\n" + text);
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- Only the detector control is generated; the stress run calls the actual Tsavorite.core epoch. -->
  <Target Name="GenerateReorderedEpochSource" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_EpochSourceDirectory>$(MSBuildThisFileDirectory)..\..\libs\storage\Tsavorite\cs\src\core\Epochs\</_EpochSourceDirectory>
      <_EpochControlDirectory>$(IntermediateOutputPath)ReorderedEpoch\</_EpochControlDirectory>
    </PropertyGroup>
    <GenerateReorderedEpoch SourceDirectory="$(_EpochSourceDirectory)" OutputDirectory="$(_EpochControlDirectory)" />
    <ItemGroup>
      <Compile Include="$(_EpochControlDirectory)*.cs" />
    </ItemGroup>
  </Target>

</Project>
